# ─── LastStep environment ──────────────────────────────────────────────────────
# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* values are sent to the browser; everything else is server-only.

# Deployment stage: development | test | staging | production
# In production the simulated notification provider is refused.
APP_ENV=development

# ── Public (browser) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable key (sb_publishable_...). The legacy anon JWT also works
# under NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: shown on /contact
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── Supabase (server only) ────────────────────────────────────────────────────
# Secret key (sb_secret_...) or legacy service_role JWT. Bypasses RLS: server only.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_STORAGE_BUCKET=submissions

# ── Security (server only) ────────────────────────────────────────────────────
# HMAC key for phone-number fingerprints and simulated OTP hashes. >= 32 chars.
# Generate: openssl rand -hex 32. Rotating it breaks STOP-suppression lookups.
PHONE_HASH_SECRET=replace-with-64-hex-chars
# Bearer token for /api/internal/dispatch (external cron / dev scheduler). >= 32 chars.
CRON_SECRET=replace-with-48-hex-chars

# ── Notifications ─────────────────────────────────────────────────────────────
# twilio | simulated. Defaults to simulated outside production; required in production.
NOTIFICATION_PROVIDER=simulated
# Required when NOTIFICATION_PROVIDER=twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# One of these two (Messaging Service recommended: handles STOP/START/HELP and A2P 10DLC):
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Optional: enables automated voice-call reminders.
TWILIO_VOICE_FROM_NUMBER=

# ── Scheduler (Inngest) ───────────────────────────────────────────────────────
# Production: from the Inngest dashboard. Local: set INNGEST_DEV=1 and run `npm run inngest:dev`.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1

# ── Retention ─────────────────────────────────────────────────────────────────
# Days to keep submitted screenshots before automatic deletion (7–3650).
EVIDENCE_RETENTION_DAYS=365
